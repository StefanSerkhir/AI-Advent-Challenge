llm_kind=Deepseek
llm_model=deepseek-v4-flash
deepseek_api_key=ВАШ_DEEPSEEK_API_KEY
# openai_api_key=ВАШ_OPENAI_API_KEY

# Необязательные настройки интерфейса и ответа
# response_mode: compare | controlled | unrestricted | reasoning | temperature | models
response_mode=compare
max_tokens=300
max_words=60
bullet_count=3
stop_sequence=<END_OF_RESPONSE>
history_enabled=true
