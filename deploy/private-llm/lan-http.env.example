# INSECURE LAB PROFILE: copy outside the repository and replace example values.
# Basic Auth is only access control here; without TLS its credentials are visible
# to any observer on the network path.
LAN_LLM_LISTEN=192.168.1.20:18080
LAN_LLM_HTPASSWD=/absolute/path/to/gateway.htpasswd

# Per-client-IP protection for Workbench API requests.
LAN_LLM_RATE=4r/s
LAN_LLM_BURST=8

# HTTP request body limit; unrelated to the model context window.
LAN_LLM_MAX_BODY_SIZE=256k
