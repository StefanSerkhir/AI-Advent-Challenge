# Copy to /etc/llm-workbench/workbench.env. These are non-secret defaults for
# the loopback Workbench process. The lowercase names match LocalConfigStore.
WEB_PORT=8080
llm_kind=Ollama
llm_model=qwen3:14b
response_mode=unrestricted
history_enabled=false
context_strategy=SLIDING_WINDOW
assistant_rag_enabled=false
stop_sequence=off
max_tokens=900
